{
  "name": "taxcodepredictor",
  "version": "0.0.1",
  "description": "CAP backend for supplier invoice processing",
  "private": true,
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap/cds": "10.1.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "10.1.1",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch:cap": "cds watch",
    "build:mta": "mbt build",
    "undeploy": "cf undeploy taxcodepredictor --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "xsuua"
      },
      "S4_INVOICE_API": {
        "kind": "odata-v2",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "SFH500_KK",
          "path": "/sap/opu/odata/sap/API_SUPPLIERINVOICE_PROCESS_SRV"
        }
      },
      "html5-repo": true,
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "engines": {
    "node": "^24"
  }
}